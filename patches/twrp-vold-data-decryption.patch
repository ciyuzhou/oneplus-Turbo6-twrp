+	static bool backupSqliteDb(const char* src, const char* dst) {
+		sqlite3* source = nullptr;
+		sqlite3* destination = nullptr;
+		sqlite3_backup* backup = nullptr;
+		int rc = sqlite3_open_v2(src, &source, SQLITE_OPEN_READONLY, nullptr);
+		if (rc == SQLITE_OK) rc = sqlite3_open(dst, &destination);
+		if (rc == SQLITE_OK) {
+			backup = sqlite3_backup_init(destination, "main", source, "main");
+			if (backup == nullptr) {
+				rc = sqlite3_errcode(destination);
+			} else {
+				rc = sqlite3_backup_step(backup, -1);
+				if (rc == SQLITE_DONE) rc = SQLITE_OK;
+				const int finish_rc = sqlite3_backup_finish(backup);
+				if (rc == SQLITE_OK) rc = finish_rc;
+			}
+		}
+		if (destination != nullptr) sqlite3_close(destination);
+		if (source != nullptr) sqlite3_close(source);
+		if (rc != SQLITE_OK) {
+			printf("Failed to back up keystore database (SQLite error %d)\n", rc);
+			return false;
+		}
+		return true;
+	}
